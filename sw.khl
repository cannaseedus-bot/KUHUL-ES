/* ============================================================
   sw.khl — K'UHUL-ES ROM CARTRIDGE v1.6.0
   Three-file runtime: sw.khl (law) + sw.js (service worker) +
   manifest.webmanifest (PWA shell)

   This file is the canonical runtime manifest for kuhul-es 1.6.0.
   It contains:
   - Embedded manifest_ast (package capabilities)
   - C@@L ATOMIC VECTORS (control flow primitives)
   - C@@L ATOMIC VARIABLES (state containers)
   - ATOMIC BLOCK DATA (boot blocks)

   K'UHUL executes C@@L BLOCKS directly.
   sw.js + index.html are data shufflers (PWA compliance).
   ============================================================ */

⟁ KERNEL_HYPER_LANGUAGE_v2 ⟁

  /* ==========================================================
     META + VERSION
     ========================================================== */
  [Pop meta]
    [Wo "sw.khl"]→[Ch'en kernel_name]
    [Wo "v1.6.0"]→[Ch'en kernel_version]
    [Wo "K'UHUL-ES: ECMAScript syntax, K'UHUL semantics"]→[Ch'en kernel_law]
    [Wo "kast/1 + kfold/1 + kxml + pwa + glsl/xvm transports"]→[Ch'en architecture]
  [Xul]


  /* ==========================================================
     JSON AST — K'UHUL-ES PACKAGE MANIFEST
     ========================================================== */
  ⟁Wo⟁ manifest_ast {
    "@context": "xjson://kuhul-es/rom/v1.6.0",
    "立v": "1.6.0",
    "n": "kuhul-es",
    "d": "K'UHUL-ES: ECMAScript syntax with K'UHUL semantics, physics, folds, KXML, and pluggable compute backends.",
    "timestamp": 1890000010000,

    "mode": "kuhul-es-runtime",
    "boot_surface": "dashboard",

    "atomic_law": "ASX = XCFE = XJSON = KUHUL = AST = ATOMIC_BLOCK",

    "kuhul_folds": {
      "runtime":  { "status": "active", "module": "runtime/src/core.js" },
      "browser":  { "status": "active", "module": "runtime/src/core.mjs" },
      "fold":     { "status": "active", "module": "runtime/src/fold-engine.js" },
      "physics":  { "status": "active", "module": "runtime/src/physics.js" },
      "think":    { "status": "active", "module": "runtime/src/think.js" },
      "pattern":  { "status": "active", "module": "runtime/src/pattern_reasoner.js" },
      "kxml":     { "status": "active", "module": "runtime/src/kxml_driver.js" },
      "chat":     { "status": "active", "module": "runtime/src/chat_bridge.js" },
      "kuhul-e":  { "status": "active", "module": "runtime/src/kuhul-e.js" },
      "trainer":  { "status": "active", "module": "runtime/src/trainer.js" },
      "attention":{ "status": "active", "module": "runtime/src/attention.js" },
      "text":     { "status": "active", "module": "runtime/src/text_dataset.js" },
      "transports":{ "status": "active", "modules": [
        "runtime/src/transports/powernaut_glsl_transport.js",
        "runtime/src/transports/xvm_d3d12_transport.js"
      ]},
      "pcre2":    { "status": "active", "module": "runtime/src/pattern_reasoner.js" },
      "pwa":      { "status": "active", "modules": ["sw.js", "index.html", "manifest.webmanifest"] },
      "grammar":  { "status": "active", "file": "kuhul_pi_grammar.ebnf" }
    },

    "runtime_profiles": {
      "node": {
        "entry": "src/index.js",
        "cli": "bin/kuhul-es.js",
        "modules": "runtime/src/*.js"
      },
      "browser": {
        "entry": "runtime/src/browser.js",
        "module": "runtime/src/core.mjs",
        "sw": "sw.js"
      }
    },

    "kast_protocols": {
      "kast/1": { "file": "schemas/kast-1.json", "role": "canonical semantic manifest" },
      "kfold/1": { "file": "schemas/kfold-1.json", "role": "lazy fold graph" }
    },

    "kxml": {
      "driver": "runtime/src/kxml_driver.js",
      "chat": "runtime/src/kxml_chat.js",
      "assets": "kxml/",
      "template": "kxml/chat_template.jinja",
      "forward_graph_to": "kfold/1"
    },

    "chat_bridge": {
      "endpoint": "/v1/chat/completions",
      "modules": ["runtime/src/chat_bridge.js", "runtime/src/chat_bridge.mjs"],
      "offline": true,
      "tools": true,
      "templates": ["kxml"]
    },

    "kuhul_e": {
      "modules": ["runtime/src/kuhul-e.js", "runtime/src/domain-stack.js", "runtime/src/response-pattern.js"],
      "default_domains": ["tech", "medical", "legal", "creative"],
      "to_kast": "kfold/1"
    },

    "trainer": {
      "module": "runtime/src/trainer.js",
      "modes": ["numeric", "token"],
      "token_features": ["embeddings", "causal_self_attention", "softmax_lm_head"],
      "backends": ["cpu", "glsl", "powernaut-glsl", "xvm-d3d12"]
    },

    "compute_backends": {
      "powernaut-glsl": {
        "bin": "bin/GLSL_Server.exe",
        "manifest": "bin/server.glsl.json",
        "shader": "bin/neural_layer.glsl",
        "archive": "bin/bin.zip"
      },
      "xvm-d3d12": {
        "dir": "bin/xvm-d3d12",
        "binaries": ["xvm_d12_host.exe", "scx2_runtime_smoke.exe", "gpt2_trainer.exe"],
        "archive": "bin/bin.zip"
      }
    },

    "bin_archive": {
      "file": "bin/bin.zip",
      "extract_script": "scripts/extract-bin.js",
      "npm_script": "extract-bin",
      "note": "Raw .exe/.dll files are excluded from the npm tarball via bin/.npmignore."
    },

    "pwa": {
      "manifest": "manifest.webmanifest",
      "service_worker": "sw.js",
      "index": "index.html",
      "icon": "kuhulpi-micronaut.png",
      "offline_capabilities": [
        "pattern_reasoning",
        "chat_completions",
        "kxml_rendering",
        "kuhul-e_response"
      ]
    },

    "pcre2": {
      "wasm_module": "pcre2/pcre2.wasm",
      "loader": "pcre2/pcre2.js",
      "fallback": "native RegExp",
      "postinstall": "npm run build:pcre2"
    },

    "rest_mesh": {
      "base": "/",
      "routes": {
        "/health":              { "fold": "os",      "handler": "health_check" },
        "/v1/chat/completions": { "fold": "chat",    "handler": "chat_completion" },
        "/kxml/run":            { "fold": "kxml",    "handler": "kxml_run" },
        "/kxml/chat":           { "fold": "kxml",    "handler": "kxml_chat" },
        "/kxml/render":         { "fold": "kxml",    "handler": "kxml_render" },
        "/kfold/expand":        { "fold": "fold",    "handler": "fold_expand" },
        "/kfold/collapse":      { "fold": "fold",    "handler": "fold_collapse" },
        "/trainer/start":       { "fold": "trainer", "handler": "trainer_start" },
        "/trainer/status":      { "fold": "trainer", "handler": "trainer_status" }
      }
    },

    "boot_sequence": [
      "kernel.init",
      "fold.mount",
      "physics.mount",
      "pattern.mount",
      "think.mount",
      "kxml.mount",
      "chat.mount",
      "kuhul-e.mount",
      "trainer.mount",
      "pcre2.mount",
      "pwa.mount",
      "asxr.ready"
    ],

    "start_url": "/",
    "display": "standalone",
    "background_color": "#020617",
    "theme_color": "#16f2aa",
    "orientation": "any",
    "scope": "/",
    "icons": ["kuhulpi-micronaut.png"],
    "short_name": "KUHUL",
    "description": "K'UHUL-ES offline semantic runtime"
  }


  /* ==========================================================
     C@@L ATOMIC VECTORS (Control Flow Primitives)
     ========================================================== */
  ⟁ COOL_ATOMIC_VECTORS ⟁

    @if_then_else = [@if condition]→[@then consequent]→[@else alternative]
    @loop         = [@loop condition]→[body]→[@break|@continue]
    @dispatch     = [@dispatch value]→[@case1|@case2|…|@default]
    @fold         = [@fold phase]→[@expand state]→[@collapse result]
    @kxml         = [@kxml op]→[@render template]→[@execute graph]

  ⟁ Xul ⟁


  /* ==========================================================
     C@@L ATOMIC VARIABLES (State Containers)
     ========================================================== */
  ⟁ COOL_ATOMIC_VARIABLES ⟁

    @kernel_state = [
      @kernel_version,
      @boot_count,
      @uptime,
      @law
    ]

    @fold_state = [
      @active_folds,
      @fold_phases,
      @latent_functions,
      @unfolds
    ]

    @runtime_state = [
      @cpu_mode,
      @gpu_backend,
      @backend_endpoint,
      @execution_queue
    ]

    @pwa_state = [
      @sw_status,
      @pcre2_status,
      @offline_ready,
      @cache_name
    ]

  ⟁ Xul ⟁


  /* ==========================================================
     1) FOLD ENGINE INIT (C@@L BLOCK)
     ========================================================== */
  [Pop fold_engine_init]
    [Wo manifest_ast.kuhul_folds.fold.module]→[Ch'en fold_module]
    [Wo "FoldEngine mounted"]→[Sek log]
    [Wo {
      "protocol": "kfold/1",
      "lazy": true,
      "physics": true,
      "events": ["expand", "collapse", "latent", "admit"]
    }]→[Yax "fold.config"]→[Sek ram_set]
  [Xul]


  /* ==========================================================
     2) KXML DRIVER INIT (C@@L BLOCK)
     ========================================================== */
  [Pop kxml_driver_init]
    [Wo manifest_ast.kxml.driver]→[Ch'en driver]
    [Wo manifest_ast.kxml.assets]→[Ch'en assets]
    [Wo "KXML driver mounted"]→[Sek log]
    [Wo {
      "forward_to": manifest_ast.kxml.forward_graph_to,
      "template": manifest_ast.kxml.template
    }]→[Yax "kxml.config"]→[Sek ram_set]
  [Xul]


  /* ==========================================================
     3) CHAT BRIDGE INIT (C@@L BLOCK)
     ========================================================== */
  [Pop chat_bridge_init]
    [Wo manifest_ast.chat_bridge.modules]→[Ch'en chat_modules]
    [Wo manifest_ast.chat_bridge.endpoint]→[Ch'en chat_endpoint]
    [Wo "Chat bridge mounted"]→[Sek log]
    [Wo {
      "endpoint": chat_endpoint,
      "offline": manifest_ast.chat_bridge.offline,
      "tools": manifest_ast.chat_bridge.tools
    }]→[Yax "chat.config"]→[Sek ram_set]
  [Xul]


  /* ==========================================================
     4) KUHUL-E INIT (C@@L BLOCK)
     ========================================================== */
  [Pop kuhul_e_init]
    [Wo manifest_ast.kuhul_e.modules]→[Ch'en domain_modules]
    [Wo manifest_ast.kuhul_e.default_domains]→[Ch'en domains]
    [Wo "KUHUL-E domain engine mounted"]→[Sek log]
    [Wo domains]→[Yax "kuhul-e.domains"]→[Sek ram_set]
  [Xul]


  /* ==========================================================
     5) TRAINER INIT (C@@L BLOCK)
     ========================================================== */
  [Pop trainer_init]
    [Wo manifest_ast.trainer.module]→[Ch'en trainer_module]
    [Wo manifest_ast.trainer.modes]→[Ch'en modes]
    [Wo manifest_ast.trainer.backends]→[Ch'en backends]
    [Wo "GLSLTrainer mounted"]→[Sek log]
    [Wo {
      "modes": modes,
      "backends": backends,
      "attention": manifest_ast.trainer.token_features
    }]→[Yax "trainer.config"]→[Sek ram_set]
  [Xul]


  /* ==========================================================
     6) COMPUTE BACKEND INIT (C@@L BLOCK)
     ========================================================== */
  [Pop compute_backend_init]
    [Wo manifest_ast.compute_backends]→[Ch'en backends]

    [@if process.env.KUHUL_BACKEND == "powernaut-glsl"]→[@then
      [Wo backends["powernaut-glsl"].bin]→[Sek backend_verify]
      [Wo "Powernaut GLSL backend selected"]→[Sek log]
    ]→[@else
      [Wo "CPU fallback selected"]→[Sek log]
    ]
  [Xul]


  /* ==========================================================
     7) PWA INIT (C@@L BLOCK)
     ========================================================== */
  [Pop pwa_init]
    [Wo manifest_ast.pwa.manifest]→[Ch'en pwa_manifest]
    [Wo manifest_ast.pwa.service_worker]→[Ch'en sw]
    [Wo "PWA shell mounted"]→[Sek log]
    [Wo {
      "manifest": pwa_manifest,
      "service_worker": sw,
      "offline_capabilities": manifest_ast.pwa.offline_capabilities
    }]→[Yax "pwa.config"]→[Sek ram_set]
  [Xul]


  /* ==========================================================
     8) PCRE2 INIT (C@@L BLOCK)
     ========================================================== */
  [Pop pcre2_init]
    [Wo manifest_ast.pcre2.wasm_module]→[Ch'en wasm]
    [Wo manifest_ast.pcre2.loader]→[Ch'en loader]
    [Wo "PCRE2 loader mounted (native RegExp fallback ready)"]→[Sek log]
    [Wo { "wasm": wasm, "loader": loader }]→[Yax "pcre2.config"]→[Sek ram_set]
  [Xul]


  /* ==========================================================
     9) HEALTH CHECK (C@@L BLOCK)
     ========================================================== */
  [Pop health_check]
    [Wo {
      "ok": true,
      "kernel": "sw.khl v1.6.0",
      "law": manifest_ast.kernel_law,
      "folds": Object.keys(manifest_ast.kuhul_folds),
      "backends": Object.keys(manifest_ast.compute_backends),
      "uptime": performance.now()
    }]→[Xul return]
  [Xul]


  /* ==========================================================
     10) BINARY ARCHIVE CHECK (C@@L BLOCK)
     ========================================================== */
  [Pop bin_archive_check]
    [Wo manifest_ast.bin_archive.file]→[Ch'en archive]
    [Wo manifest_ast.bin_archive.extract_script]→[Ch'en extractor]
    [Wo { "archive": archive, "extractor": extractor }]→[Ch'en info]

    [@if archive exists]→[@then
      [Wo "Native compute binaries archived in bin/bin.zip"]→[Sek log]
      [Wo "Run `npm run extract-bin` before using GPU backends"]→[Sek log]
    ]→[@else
      [Wo "bin/bin.zip not present; GPU backends require manual setup"]→[Sek warn]
    ]
  [Xul]


  /* ==========================================================
     KERNEL BOOT SEQUENCE (C@@L BLOCK ORCHESTRATION)
     ========================================================== */
  [Pop kernel_boot]
    [Wo "⟁ K'UHUL-ES v1.6.0 booting..."]→[Sek log]

    [Sek fold_engine_init]
    [Sek kxml_driver_init]
    [Sek chat_bridge_init]
    [Sek kuhul_e_init]
    [Sek trainer_init]
    [Sek compute_backend_init]
    [Sek pcre2_init]
    [Sek pwa_init]
    [Sek bin_archive_check]

    [Wo "active"]→[Yax "os.state"]→[Sek ram_set]
    [Wo "⟁ K'UHUL-ES ONLINE"]→[Sek log]
    [Wo manifest_ast.kernel_law]→[Sek log]
  [Xul]


⟁ FINAL_LOCK ⟁
(* This ROM matches kuhul-es@1.6.0.
   Legacy ASX Ghost OS content preserved in sw.khl.legacy. *)
