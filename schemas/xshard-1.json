{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuhul.dev/schema/xshard-1.json",
  "title": "XSHARD/1 Manifest",
  "description": "Fold-tagged streaming tensor shard manifest embedded in the XSHARD binary header.",
  "type": "object",
  "required": ["@kind", "version", "model", "dtype_default", "alignment", "n_shards", "state_start", "data_start", "shards"],
  "additionalProperties": false,
  "properties": {
    "@kind":         { "const": "xshard/1" },
    "version":       { "const": 1 },
    "created":       { "type": "string", "format": "date-time" },
    "model":         { "type": "string", "description": "Model identifier string" },
    "arch":          { "type": "string", "description": "Architecture hint, e.g. gpt2, llama" },
    "n_layer":       { "type": "integer", "minimum": 1 },
    "n_embd":        { "type": "integer", "minimum": 1 },
    "n_head":        { "type": "integer", "minimum": 1 },
    "vocab_size":    { "type": "integer", "minimum": 1 },
    "dtype_default": { "$ref": "#/definitions/DtypeName" },
    "alignment":     { "type": "integer", "enum": [16, 32, 64, 128], "description": "Byte alignment for shard data blocks" },
    "n_shards":      { "type": "integer", "minimum": 1 },
    "state_start":   { "type": "integer", "minimum": 0, "description": "Byte offset of state block from file start" },
    "data_start":    { "type": "integer", "minimum": 0, "description": "Byte offset of first shard data block from file start" },
    "shards":        { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/ShardRecord" } }
  },
  "definitions": {
    "DtypeName": {
      "enum": ["F32", "BF16", "F16", "INT8", "Q8_0", "Q4_K"],
      "description": "Tensor element data type"
    },
    "PhaseName": {
      "enum": ["Pop", "Wo", "Yax", "Sek", "Chen", "Xul"],
      "description": "K'UHUL fold phase owning this shard"
    },
    "ShardRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "tensor_name", "shape", "dtype", "offset", "nbytes", "sha256"],
      "properties": {
        "id":            { "type": "string", "description": "Unique shard identifier within file" },
        "seq":           { "type": "integer", "minimum": 0, "description": "Sequential index into state block" },
        "tensor_name":   { "type": "string", "description": "Original tensor key from source model" },
        "fold":          { "$ref": "#/definitions/PhaseName" },
        "phase_angle":   { "type": "number", "minimum": 0, "maximum": 6.2832, "description": "Phase angle in radians; Pop=0, Xul=5π/3" },
        "shape":         { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
        "dtype":         { "$ref": "#/definitions/DtypeName" },
        "stride":        { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Row-major strides; omit for C-contiguous" },
        "offset":        { "type": "integer", "minimum": 0, "description": "Byte offset from data_start" },
        "nbytes":        { "type": "integer", "minimum": 1, "description": "Byte count of raw shard data" },
        "sha256":        { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 hex of raw bytes at creation time" },
        "shard_of":      { "type": "string", "description": "Parent tensor name when sub-sharding" },
        "shard_index":   { "type": "integer", "minimum": 0, "description": "This shard's position within the parent tensor" },
        "shard_count":   { "type": "integer", "minimum": 1, "description": "Total number of shards for parent tensor" },
        "shard_axis":    { "type": "integer", "minimum": 0, "description": "Axis the parent tensor is split along" },
        "shard_slice":   {
          "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2,
          "description": "[start, end) in shard_axis dimension"
        },
        "training_steps": { "type": "integer", "minimum": 0, "description": "Training steps applied (informational; authoritative in .meta.json)" },
        "best_loss":      { "type": ["number", "null"], "description": "Best loss seen during training" }
      }
    }
  }
}
