    "sw.js",
    "kuhulpi-micronaut.png",
    "README.md",
    "license.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ofjansen/pcre2-wasm": "^1.4.0",
    "commander": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "description": "K'UHUL-ES — ECMAScript syntax, K'UHUL semantics + physics + thinking + KXML inference"
