{
  "name": "kuhul-es",
  "version": "1.4.0",
  "description": "K'UHUL-ES browser runtime — ECMAScript syntax, K'UHUL semantics, KXML inference",
  "manifest_version": 1,
  "entry_points": {
    "node": "src/index.js",
    "browser": "runtime/src/browser.js",
    "worker": "runtime/src/core.mjs",
    "service_worker": "sw.js"
  },
  "exports": {
    ".": {
      "node": "./src/index.js",
      "browser": {
        "default": "./runtime/src/browser.js"
      },
      "default": "./src/index.js"
    },
    "./runtime/node": "./runtime/src/node.js",
    "./runtime/browser": "./runtime/src/browser.js",
    "./runtime/physics": "./runtime/src/physics.js",
    "./runtime/trainer": "./runtime/src/trainer.js",
    "./runtime/kxml": "./runtime/src/kxml_driver.js",
    "./runtime/kxml/chat": "./runtime/src/kxml_chat.js",
    "./runtime/stb": "./runtime/src/stb_reader.js",
    "./runtime/core": {
      "node": "./runtime/src/core.js",
      "browser": "./runtime/src/core.mjs"
    }
  },
  "wasm": {
    "optional": [
      "@ofjansen/pcre2-wasm"
    ],
    "note": "PCRE2-WASM is optional. Without it, the pattern reasoner falls back to native RegExp."
  },
  "browser_capabilities": [
    "kuhul-runtime",
    "physics-engine",
    "thinking-engine",
    "pattern-reasoner",
    "semantic-trainer",
    "kxml-inference",
    "stb-tensor-loading",
    "pwa-service-worker",
    "offline-execution"
  ],
  "kxml": {
    "model_manifest_format": "khanary-model-stb/v1",
    "supported_glyphs": [
      "G_EMBED",
      "G_LAYERNORM",
      "G_MATMUL",
      "G_ATTENTION",
      "G_GELU"
    ],
    "supported_phases": [
      "Pop",
      "Wo",
      "Sek",
      "Ch'en",
      "Xul"
    ],
    "node_to_fold_mapping": {
      "EMBED_NODE": "Pop",
      "LAYERNORM_NODE": "Wo",
      "FFN_NODE": "Sek",
      "ATTENTION_NODE": "Sek",
      "LM_HEAD_NODE": "Xul",
      "LOSS_NODE": "Ch'en",
      "FIELD_OPTIMIZER_NODE": "Ch'en"
    }
  },
  "service_worker": {
    "path": "sw.js",
    "scope": ".",
    "type": "module",
    "cache_name": "kuhul-es-v1.4.0",
    "precache": [
      "./",
      "./index.html",
      "./browser.manifest.json",
      "./manifest.webmanifest",
      "./runtime/src/core.mjs",
      "./runtime/src/browser.js",
      "./pcre2/pcre2.js",
      "./pcre2/pcre2.wasm"
    ]
  },
  "files": {
    "required": [
      "src/index.js",
      "index.html",
      "manifest.webmanifest",
      "browser.manifest.json",
      "sw.js",
      "kuhulpi-micronaut.png",
      "runtime/src/core.js",
      "runtime/src/core.mjs",
      "runtime/src/browser.js",
      "runtime/src/physics.js",
      "runtime/src/think.js",
      "runtime/src/pattern_reasoner.js",
      "runtime/src/expression_evaluator.js",
      "runtime/src/runtime_parser.js",
      "runtime/src/kxml_driver.js",
      "runtime/src/kxml_chat.js",
      "runtime/src/stb_reader.js",
      "runtime/src/glsl_kernels.js",
      "pcre2/pcre2.js",
      "pcre2/pcre2.wasm"
    ],
    "optional": [
      "compiler/src/parser.js",
      "compiler/src/driver-kast.js"
    ]
  },
  "dependencies": {
    "runtime": [],
    "optional": {
      "commander": "for CLI only; not loaded in browser",
      "typescript": "for compiler AST only; not loaded at runtime",
      "@ofjansen/pcre2-wasm": "for full PCRE2 regex in browser"
    }
  },
  "license": "Proprietary"
}
